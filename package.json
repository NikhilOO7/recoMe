{
  "name": "recome",
  "version": "2.0.0",
  "description": "Your personal interest graph plus a team of background agents that work it for you.",
  "private": true,
  "scripts": {
    "dev": "webpack --config webpack.config.js --watch --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint extension/src packages",
    "lint:fix": "eslint extension/src packages --fix",
    "format": "prettier --write \"{extension,packages}/**/*.{ts,tsx,css}\"",
    "validate": "npm run typecheck && npm run lint && npm test",
    "version": "node scripts/sync-version.js && git add extension/src/manifest.json",
    "postbuild": "node scripts/sync-version.js",
    "seed:demo": "npx tsx scripts/seed-local.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/chrome": "^0.1.37",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "eslint": "^9.24.0",
    "fake-indexeddb": "^6.2.5",
    "html-webpack-plugin": "^5.6.6",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.4.0",
    "mini-css-extract-plugin": "^2.10.1",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.2.1",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.4",
    "typescript": "^6.0.3",
    "webpack": "^5.105.4",
    "webpack-cli": "^6.0.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
