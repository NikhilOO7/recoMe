# RecoMe — example environment / demo credentials.
#
# Copy any values you actually need to a `.env` file in the same directory
# (cloud/.env, web/.env.local, etc. depending on the subproject). Never commit
# the real values back; .env is in .gitignore.
#
# Real production secrets live in Fly secrets (cloud) / Vercel env vars (web).
# See docs/architecture/0015-hld.md §5.4.

# ── Demo / local-dev account ────────────────────────────────────────────
# Used by scripts/dev-local.sh + the docker-compose Postgres seed.
DEMO_USER_EMAIL=demo@recome.local
DEMO_USER_PASSWORD=demo1234!

# ── Cloud (cloud/.env) ──────────────────────────────────────────────────
DATABASE_URL=postgresql://recome:recome@localhost:5432/recome
DIRECT_URL=postgresql://recome:recome@localhost:5432/recome
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=recome-neo4j
QDRANT_URL=http://localhost:6333
OPENAI_API_KEY=sk-...
JWT_ACCESS_SECRET=change-me-32-chars-min
JWT_REFRESH_SECRET=change-me-32-chars-min
INTELLIGENCE_ENABLED=true
INTELLIGENCE_AGENTS_ENABLED=true
FLY_API_TOKEN=cTNleWJkZnRtbW0zbmpocmJwa3FxcG5kcGVoa2k3dDY

# ── Web (web/.env.local) ────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:8080
