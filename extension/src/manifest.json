{
  "manifest_version": 3,
  "name": "RecoMe",
  "version": "1.2.0",
  "description": "Intelligent recommendation feed control. Your feed, your rules.",
  "permissions": ["storage", "alarms", "tabs", "activeTab", "notifications"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RecoMe",
    "default_icon": {
      "16": "icons/recome_logo_16.png",
      "48": "icons/recome_logo_48.png",
      "128": "icons/recome_logo_128.png"
    }
  },
  "icons": {
    "16": "icons/recome_logo_16.png",
    "48": "icons/recome_logo_48.png",
    "128": "icons/recome_logo_128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://*/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com; object-src 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Open RecoMe popup"
    },
    "quick_block": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Quick block current page topic"
    },
    "toggle_extension": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Toggle RecoMe on/off"
    },
    "toggle_overlay": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "Toggle RecoMe floating overlay"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "recome@recome.dev",
      "strict_min_version": "109.0"
    }
  }
}
