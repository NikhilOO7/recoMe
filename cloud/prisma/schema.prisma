generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct connection URL for migrations (bypasses connection pooler)
  directUrl = env("DIRECT_URL")
}

// ── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  displayName   String?
  avatarUrl     String?

  // OAuth
  googleId      String?   @unique
  githubId      String?   @unique

  // Subscription
  tier          Tier      @default(FREE)
  stripeCustomerId   String?  @unique
  stripeSubscriptionId String?

  // Sync
  syncStates    SyncState[]
  devices       Device[]

  // Taste Twin
  tasteProfile  TasteProfile?

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSyncAt    DateTime?

  @@index([email])
}

model Device {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  fingerprint   String    @unique
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  deviceId      String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([userId])
  @@index([tokenHash])
}

// ── Sync ─────────────────────────────────────────────────────────────────────

model SyncState {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataType      SyncDataType
  version       Int       @default(0)
  checksum      String?

  // E2E encrypted blob (AES-256-GCM)
  encryptedData Bytes?
  iv            Bytes?
  authTag       Bytes?

  lastModified  DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@unique([userId, dataType])
  @@index([userId])
}

// ── Billing ──────────────────────────────────────────────────────────────────

model BillingEvent {
  id            String    @id @default(cuid())
  userId        String
  eventType     String
  stripeEventId String?   @unique
  amount        Int?
  currency      String?
  metadata      Json?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([stripeEventId])
}

// ── Usage Tracking ───────────────────────────────────────────────────────────

model UsageRecord {
  id            String    @id @default(cuid())
  userId        String
  feature       String
  count         Int       @default(1)
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime  @default(now())

  @@unique([userId, feature, periodStart])
  @@index([userId])
}

// ── Taste Twin Network ──────────────────────────────────────────────────────

/// User's anonymized taste vector — encrypted interest embeddings for matching.
/// Privacy: only hashed/bucketed signals are stored; raw interests never leave the device.
model TasteProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Consent flag — must be true before any matching occurs
  consentGiven  Boolean   @default(false)
  consentAt     DateTime?

  /// Anonymized taste vector (JSON array of bucketed interest signals)
  tasteVector   Json?

  /// Visibility settings
  isDiscoverable Boolean  @default(true)

  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
}

/// Computed similarity match between two users.
/// Always stored with userId1 < userId2 (canonical ordering).
model TwinMatch {
  id            String    @id @default(cuid())
  userId1       String
  userId2       String
  similarityScore Float
  sharedBuckets   Int       @default(0)

  /// Whether each user has accepted the match
  user1Accepted Boolean   @default(false)
  user2Accepted Boolean   @default(false)

  /// Abuse control: report/block flags
  reportedBy    String?
  blockedAt     DateTime?

  computedAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  recommendations TwinRecommendation[]

  @@unique([userId1, userId2])
  @@index([userId1])
  @@index([userId2])
  @@index([similarityScore])
}

/// Recommendations surfaced from a twin's activity.
/// Never reveals the twin's identity — only the recommendation content.
model TwinRecommendation {
  id            String    @id @default(cuid())
  matchId       String
  match         TwinMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  recipientId   String
  /// Anonymized recommendation: topic, platform, reason — no PII
  title         String
  body          String
  platform      String?
  relevanceScore Float    @default(0)

  actedOn       Boolean   @default(false)
  dismissedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([recipientId])
  @@index([matchId])
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Tier {
  FREE
  PRO
  PREMIUM
}

enum SyncDataType {
  PREFERENCES
  INTEREST_GRAPH
  FILTER_RULES
  DECISION_HISTORY
  PLATFORM_SETTINGS
}
