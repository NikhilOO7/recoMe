generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct connection URL for migrations (bypasses connection pooler)
  directUrl = env("DIRECT_URL")
}

// ── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  displayName   String?
  avatarUrl     String?

  // OAuth
  googleId      String?   @unique
  githubId      String?   @unique
  facebookId    String?   @unique

  // Role & Subscription
  role          Role      @default(USER)
  tier          Tier      @default(FREE)
  stripeCustomerId   String?  @unique
  stripeSubscriptionId String?

  // Sync
  syncStates    SyncState[]
  devices       Device[]

  // Taste Twin
  tasteProfile  TasteProfile?

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSyncAt    DateTime?

  @@index([email])
}

model Device {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  fingerprint   String    @unique
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  deviceId      String?
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([userId])
  @@index([tokenHash])
}

// ── Sync ─────────────────────────────────────────────────────────────────────

model SyncState {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataType      SyncDataType
  version       Int       @default(0)
  checksum      String?

  // E2E encrypted blob (AES-256-GCM)
  encryptedData Bytes?
  iv            Bytes?
  authTag       Bytes?

  lastModified  DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@unique([userId, dataType])
  @@index([userId])
}

// ── Billing ──────────────────────────────────────────────────────────────────

model BillingEvent {
  id            String    @id @default(cuid())
  userId        String
  eventType     String
  stripeEventId String?   @unique
  amount        Int?
  currency      String?
  metadata      Json?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([stripeEventId])
}

// ── Usage Tracking ───────────────────────────────────────────────────────────

model UsageRecord {
  id            String    @id @default(cuid())
  userId        String
  feature       String
  count         Int       @default(1)
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime  @default(now())

  @@unique([userId, feature, periodStart])
  @@index([userId])
}

// ── Taste Twin Network ──────────────────────────────────────────────────────

/// User's anonymized taste vector — encrypted interest embeddings for matching.
/// Privacy: only hashed/bucketed signals are stored; raw interests never leave the device.
model TasteProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Consent flag — must be true before any matching occurs
  consentGiven  Boolean   @default(false)
  consentAt     DateTime?

  /// Anonymized taste vector (JSON array of bucketed interest signals)
  tasteVector   Json?

  /// Visibility settings
  isDiscoverable Boolean  @default(true)

  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
}

/// Computed similarity match between two users.
/// Always stored with userId1 < userId2 (canonical ordering).
model TwinMatch {
  id            String    @id @default(cuid())
  userId1       String
  userId2       String
  similarityScore Float
  sharedBuckets   Int       @default(0)

  /// Whether each user has accepted the match
  user1Accepted Boolean   @default(false)
  user2Accepted Boolean   @default(false)

  /// Abuse control: report/block flags
  reportedBy    String?
  blockedAt     DateTime?

  computedAt    DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  recommendations TwinRecommendation[]

  @@unique([userId1, userId2])
  @@index([userId1])
  @@index([userId2])
  @@index([similarityScore])
}

/// Recommendations surfaced from a twin's activity.
/// Never reveals the twin's identity — only the recommendation content.
model TwinRecommendation {
  id            String    @id @default(cuid())
  matchId       String
  match         TwinMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  recipientId   String
  /// Anonymized recommendation: topic, platform, reason — no PII
  title         String
  body          String
  platform      String?
  relevanceScore Float    @default(0)

  actedOn       Boolean   @default(false)
  dismissedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([recipientId])
  @@index([matchId])
}

// ── Admin: Feature Flags ────────────────────────────────────────────────────

model FeatureFlag {
  id            String    @id @default(cuid())
  key           String    @unique
  name          String
  description   String?
  enabled       Boolean   @default(false)
  /// Rollout percentage (0-100). 100 = all users. 0 = disabled.
  rolloutPercent Int      @default(0)
  /// Target tiers (empty = all tiers)
  targetTiers   String[]  @default([])
  /// Target user IDs for beta testing
  targetUsers   String[]  @default([])
  /// Which app this flag applies to
  app           AppType   @default(EXTENSION)
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ── Admin: Error Logs ──────────────────────────────────────────────────────

model ErrorLog {
  id            String    @id @default(cuid())
  /// Source app: extension, web, cloud, mobile
  source        AppType
  /// Error level: error, warn, info
  level         String    @default("error")
  message       String
  stack         String?
  /// User who triggered it (optional)
  userId        String?
  /// Additional metadata (browser, version, platform, URL)
  metadata      Json?
  createdAt     DateTime  @default(now())

  @@index([source])
  @@index([createdAt])
  @@index([userId])
}

// ── Admin: Deployment Pipelines ────────────────────────────────────────────

model Deployment {
  id            String          @id @default(cuid())
  app           AppType
  version       String
  environment   DeployEnv       @default(PRODUCTION)
  status        DeployStatus    @default(PENDING)
  /// Git commit SHA or tag
  commitSha     String?
  /// Deployment notes
  notes         String?
  /// Who triggered the deployment
  triggeredBy   String?
  /// Deployment URL (e.g., fly.io URL, vercel URL)
  deployUrl     String?
  /// Build log or error output
  buildLog      String?
  startedAt     DateTime        @default(now())
  completedAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([app])
  @@index([status])
  @@index([createdAt])
}

// ── Admin: App Configuration ───────────────────────────────────────────────

model AppConfig {
  id            String    @id @default(cuid())
  app           AppType
  /// Config key (e.g., "min_extension_version", "maintenance_mode")
  key           String
  value         String
  /// Type hint for the admin UI (string, number, boolean, json)
  valueType     String    @default("string")
  description   String?
  updatedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([app, key])
  @@index([app])
}

// ── Admin: Audit Log ───────────────────────────────────────────────────────

model AuditLog {
  id            String    @id @default(cuid())
  /// Admin user who performed the action
  adminId       String
  /// Action type (e.g., "feature_flag.update", "user.ban", "deploy.trigger")
  action        String
  /// Target resource type and ID
  resourceType  String?
  resourceId    String?
  /// Before/after values
  details       Json?
  createdAt     DateTime  @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum Tier {
  FREE
  PRO
  PREMIUM
}

enum AppType {
  EXTENSION
  WEB
  CLOUD
  MOBILE
  SDK
  AGENTS
}

enum DeployEnv {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum DeployStatus {
  PENDING
  BUILDING
  DEPLOYING
  SUCCESS
  FAILED
  ROLLED_BACK
}

enum SyncDataType {
  PREFERENCES
  INTEREST_GRAPH
  FILTER_RULES
  DECISION_HISTORY
  PLATFORM_SETTINGS
}
