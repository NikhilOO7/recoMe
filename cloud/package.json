{
  "name": "@recome/cloud",
  "version": "1.0.0",
  "description": "RecoMe cloud backend — sync, auth, billing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --pretty false || true",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "graph:migrate": "tsx scripts/migrate.ts",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@prisma/client": "^6.5.0",
    "@qdrant/js-client-rest": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "hono": "^4.7.6",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "neo4j-driver": "^5.24.0",
    "openai": "^4.73.1",
    "pino": "^9.5.0",
    "stripe": "^17.7.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.1",
    "pino-pretty": "^11.3.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
