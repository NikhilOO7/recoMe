{
  "name": "@recome/cloud",
  "version": "1.0.0",
  "description": "RecoMe cloud backend — sync, auth, billing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@prisma/client": "^6.5.0",
    "hono": "^4.7.6",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^17.7.0",
    "bcryptjs": "^3.0.2",
    "zod": "^3.24.3",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.1",
    "prisma": "^6.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
