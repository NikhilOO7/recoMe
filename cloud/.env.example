# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Get these from: Supabase Dashboard > Settings > Database > Connection string
# Use the "Transaction" (pooled) URL for DATABASE_URL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use the "Session" (direct) URL for DIRECT_URL (needed for Prisma migrations)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── OAuth (optional — get credentials from each provider's developer console) ─
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# ── Stripe (optional) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_PREMIUM_PRICE_ID=""

# ── Intelligence stack (ADR-0001) ────────────────────────────────────────────
# Turn on once Neo4j, Qdrant, and OpenAI keys are wired up.
INTELLIGENCE_ENABLED="false"
# Run cypher migrations automatically on boot. Safe in dev; in prod prefer a
# one-shot migration job via `npm run graph:migrate` (see scripts/migrate.ts).
INTELLIGENCE_RUN_MIGRATIONS_ON_BOOT="false"

# Neo4j — local: bolt://localhost:7687  •  AuraDB: neo4j+s://<host>:7687
NEO4J_URI=""
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"

# Qdrant — local: http://localhost:6333  •  Cloud: https://<cluster>.qdrant.io
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="recome_v1"

# OpenAI embeddings
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL="info"  # fatal | error | warn | info | debug | trace

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="production"
CORS_ORIGINS="chrome-extension://*"

# ── Local Development Override ───────────────────────────────────────────────
# For local dev, use:
# DATABASE_URL="postgresql://recome:recome@localhost:5432/recome?schema=public"
# DIRECT_URL="postgresql://recome:recome@localhost:5432/recome?schema=public"
# NODE_ENV="development"
# CORS_ORIGINS="chrome-extension://,http://localhost:*"
# INTELLIGENCE_ENABLED="true"
# NEO4J_URI="bolt://localhost:7687"
# NEO4J_PASSWORD="recomeneo4jdev"
# QDRANT_URL="http://localhost:6333"
