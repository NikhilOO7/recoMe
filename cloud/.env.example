# ─────────────────────────────────────────────────────────────────────────────
# Recome — cloud backend env. Source of truth for every variable the cloud
# reads. Mirrors cloud/src/config.ts; if you add a var there, add it here.
#
# Quick start (local dev):
#   cp cloud/.env.example cloud/.env   # then fill in the placeholders
# OR — for a one-command local stack with docker:
#   scripts/dev-local.sh               # writes a managed cloud/.env for you
# ─────────────────────────────────────────────────────────────────────────────


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the cloud refuses to boot without these.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Postgres) ──────────────────────────────────────────────────────
# Prod: Supabase. Local: docker (see scripts/dev-local.sh).
#
#   • DATABASE_URL → pooled connection (Supabase "Transaction" URL)
#   • DIRECT_URL   → direct connection, used by Prisma migrations only
#
# Supabase URL shape:
#   postgresql://postgres.<project-ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Local docker shape:
#   postgresql://recome:recome@localhost:5432/recome?schema=public
DATABASE_URL=""
DIRECT_URL=""

# ── Auth ─────────────────────────────────────────────────────────────────────
# JWT_SECRET must be ≥32 chars. Generate one with: openssl rand -hex 32
JWT_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"


# ─────────────────────────────────────────────────────────────────────────────
# SERVER + LOGGING
# ─────────────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"                  # development | production | test
LOG_LEVEL="info"                        # fatal | error | warn | info | debug | trace
# Comma-separated origin patterns. Wildcards allowed on port.
# Web app on Next dev → http://localhost:3000  •  Extension → chrome-extension://<id>
CORS_ORIGINS="http://localhost:*,chrome-extension://*"


# ─────────────────────────────────────────────────────────────────────────────
# INTELLIGENCE STACK — ADR-0001 / ADR-0012.
# Required for every surface we built in waves 1–6 (Inbox, Mind Map, Trails,
# Personality Mirror, Audit Log, Concierge, Curator). With INTELLIGENCE_ENABLED
# unset, the `/intelligence/*` routes are not mounted and the UI 404s.
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  z.coerce.boolean is JS-truthy — "false" coerces to true. Leave keys
# unset for default off, or set to "true" to enable.
# INTELLIGENCE_ENABLED="true"           # enable Neo4j + Qdrant + OpenAI
# INTELLIGENCE_AGENTS_ENABLED="true"    # boot Recall + Concierge
# INTELLIGENCE_RUN_MIGRATIONS_ON_BOOT="true"   # safe in dev; in prod use `npm run graph:migrate`

# Scheduled agent ticks (BullMQ over Redis): Curator daily + Concierge 4×/day
# watchlist sweep. Requires REDIS_URL (Upstash works). Enable on EXACTLY ONE
# instance per fleet to avoid duplicate registrations on boot.
# AGENT_WORKERS_ENABLED="true"
# REDIS_URL="rediss://default:<token>@<host>.upstash.io:6379"

# ── Neo4j (the interest graph) ───────────────────────────────────────────────
# AuraDB Free works for prod evaluation; local docker exposes bolt at 7687.
#   Local:  bolt://localhost:7687  /  user=neo4j  /  pw=recomeneo4jdev (from docker-compose.yml)
#   AuraDB: neo4j+s://<host>:7687
NEO4J_URI=""
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD=""
NEO4J_DATABASE="neo4j"

# ── Qdrant (per-user vector namespaces) ──────────────────────────────────────
# Cloud (Qdrant Cloud) or local docker. API key only needed for Cloud.
QDRANT_URL=""                           # local: http://localhost:6333
QDRANT_API_KEY=""
QDRANT_COLLECTION="recome_v1"

# ── OpenAI embeddings ────────────────────────────────────────────────────────
# Required when INTELLIGENCE_ENABLED=true — boot fails fast if missing.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ── Agents — Concierge price vendor (ADR-0017) ───────────────────────────────
# `stub`  : deterministic test data, fine for dev. Refused in prod (Concierge
#           skips until a real vendor is wired).
# `keepa` : real Amazon prices via keepa.com. Requires KEEPA_API_KEY. Amazon-
#           only for v1; Walmart/eBay land in a v1.2 ADR alongside Rainforest.
INTELLIGENCE_AGENTS_PRICE_VENDOR="stub"
# KEEPA_API_KEY=""

# ── Stripe Meters (P4.1) — IaaS usage-based billing ──────────────────────────
# Per-metric Stripe Meter event names. Unset metrics are skipped by the daily
# rollup worker, so you can roll out one meter at a time.
# Configure these in Stripe Dashboard → Billing → Meters.
# STRIPE_METER_SIGNALS_ID="recome_signals_ingested"
# STRIPE_METER_QUERIES_ID="recome_queries_served"
# STRIPE_METER_EMBEDDINGS_ID="recome_embeddings_billed"

# ── PWA Push (P4.3, VAPID) ────────────────────────────────────────────────────
# Generate ONCE with: npx web-push generate-vapid-keys
# Put both in Fly secrets; the public key is also served via
# GET /notifications/push/vapid-public-key so the web client doesn't have
# to hardcode it.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_CONTACT="mailto:hello@recome.app"

# ── Email (P4.4, Resend) ──────────────────────────────────────────────────────
# Weekly digest of unseen AgentEvents. EmailService no-ops when the API key
# is unset, so dev / preview deploys never email anyone by accident.
# RESEND_FROM must be a verified sender on the Resend account.
# RESEND_API_KEY="re_..."
# RESEND_FROM="Recome <digest@recome.app>"

# ── Agents — Curator content source ──────────────────────────────────────────
# Same shape as price vendor — `stub` returns fixture items per topic. Real
# backends (RSS / YouTube uploads / Reddit / Substack / arXiv) land next cycle.
INTELLIGENCE_AGENTS_CONTENT_SOURCE="stub"


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — OAuth providers. Leave blank to disable that provider's login.
# Each provider config is independent; the cloud serves a 501 from
# /auth/oauth/:provider/start when the provider is unconfigured.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Stripe (billing). Leave blank to disable billing endpoints.
# Get keys from https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_PREMIUM_PRICE_ID=""


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — Integration test toggles. Local dev rarely sets these.
# ─────────────────────────────────────────────────────────────────────────────
# Set to "1" to run the live-DB integration tests in src/intelligence/__tests__/
# (thesis-flow.integration.test.ts). Requires the intelligence stack envs above.
RUN_INTEGRATION=""
# Set to "1" to wipe Neo4j + Qdrant between integration runs. Useful in CI.
CLEAN_INTEGRATION=""
