{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",
    "paths": {
      "@schema": ["packages/schema"],
      "@schema/*": ["packages/schema/*"],
      "@utils/*": ["packages/utils/*"],
      "@ui/*": ["packages/ui/*"],
      "@shared/*": ["extension/src/shared/*"],
      "@intelligence/*": ["brain/src/*"],
      "@brain/*": ["brain/src/*"],
      "@agent/*": ["agent/src/*"],
      "@data/*": ["brain/src/storage/*"],
      "@background/*": ["extension/src/background/*"],
      "@content/*": ["extension/src/content/*"],
      "@popup/*": ["extension/src/popup/*"],
      "@devtools/*": ["extension/src/devtools/*"]
    },

    "outDir": "./dist",
    "sourceMap": true,
    "declaration": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["chrome"],
    "ignoreDeprecations": "5.0"
  },
  "include": ["extension/src/**/*", "brain/src/**/*", "agent/src/**/*", "packages/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
